@startuml

class User extends UriEntity implements UserDetails {
  email : String
  password : String
  fullName : String
  phone : String
  role : Role
  status : Status
  emailVerifiedAt : ZonedDateTime
  created : Instant
}

enum Role {
  DRIVER
  COMPANY_STAFF
  ADMIN
}

enum Status {
  PENDING_EMAIL
  ACTIVE
}

class UriEntity {
  uri : String
}

@enduml
